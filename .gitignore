# Flix build output
build/
*.fpkg
*.jar
crash_report_*.txt
artifact/
lib/
site/
out/

# scala-cli, for scripts/*.scala
.scala-build/
.bsp/

# Reports from scripts/class-id-report; several megabytes per run.
symbols-*.csv
ids-*.txt

# ports/{scala,java,kotlin,clojure} build output -- each subproject's own
# toolchain (sbt, Maven, Gradle, Leiningen), independent of flixw.
ports/**/target/
ports/**/build/
ports/**/.gradle/
ports/clojure/.lein-failures

# The global *.jar rule above would also catch the Kotlin subproject's
# committed Gradle wrapper jar, without which ./gradlew cannot bootstrap on
# a fresh clone.
!ports/kotlin/gradle/wrapper/gradle-wrapper.jar

# Machine-specific, never meant to be shared -- see .envrc.example
.envrc
.envrc.local
.GITHUB_TOKEN

# OS
.DS_Store

# Local Claude Code settings
.claude/settings.local.json
