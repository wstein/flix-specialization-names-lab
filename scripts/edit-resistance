#!/usr/bin/env bash
# Runs edit-resistance.scala against a Flix compiler jar. `scala-cli`'s `using
# jar` directive is a static literal -- it cannot shell out or read an env
# var -- so edit-resistance.scala alone has no classpath and running it with
# `scala-cli run` directly fails to compile. This resolves the jar and hands
# it to scala-cli as `--jar`.
#
# This never goes through flixw, on purpose: the whole point of the lab is comparing two
# different compiler builds (counter-suffix vs. hash-suffix) against the same source, and
# flixw only ever holds one pinned jar at a time. Jar resolution, in order, first match wins:
#   1. --flix-jar <path>  passed on this script's own command line
#   2. $FLIX_JAR          same override convention flixw itself uses for
#                         running a compiler it did not download (see
#                         .envrc.example); unverified, same as there
#   3. ./flix.jar         a jar placed at the project root by hand
#   4. `flix` on $PATH    whatever a system-installed Flix resolves to.
#                         Only works if that is itself a jar (or a
#                         polyglot self-executing one, e.g. a shebang
#                         prepended to a real jar) -- scala-cli's --jar
#                         needs an actual jar, not a launcher script, and
#                         this is unverified either way
#
# Usage:
#   ./scripts/edit-resistance [source.flix]
#   ./scripts/edit-resistance --flix-jar path/to/flix.jar [source.flix]
#   ./scripts/edit-resistance --compiler-version string [source.flix]
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: ./scripts/edit-resistance [--flix-jar path/to/flix.jar] [source.flix]
                                  [--compiler-version string]

Measures how many generated class names, and how many generated classes,
survive a set of edits to source.flix (default: src/Main.flix).

Options:
  --flix-jar <path>        Flix compiler jar to compile against. Overrides
                            every other source below.
  --compiler-version <str> Label the report with what produced it. Neither a
                            jar's manifest nor its class files record this
                            (verified by hand), so it can't be read back --
                            if not given, it's filled in based on how the
                            jar below was resolved.
  -h, --help                Show this help and exit.

Jar resolution when --flix-jar is not given, first match wins. This never
consults flixw, even if present: it deliberately holds only one pinned jar,
and this needs to compare arbitrary builds against each other.
  1. $FLIX_JAR        unverified, as in .envrc.example
  2. ./flix.jar        a jar placed at the project root by hand
  3. `flix` on $PATH   a system-installed Flix, if it resolves to a jar
EOF
}

# Parsed here, ahead of everything else below, so --help/-h short-circuits
# before this wipes build/ or resolves a jar.
jar=${FLIX_JAR:-}
compiler_version=""
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --flix-jar)
      jar=$2
      shift 2
      ;;
    --flix-jar=*)
      jar=${1#--flix-jar=}
      shift
      ;;
    --compiler-version)
      compiler_version=$2
      shift 2
      ;;
    --compiler-version=*)
      compiler_version=${1#--compiler-version=}
      shift
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done

root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"

# This tool compiles in-process and never reads or writes build/ itself, but
# a stale build/ from an earlier ./flixw build or ./flixw test can linger
# alongside it. Wiping it here keeps a run's disk footprint to just what this
# invocation produces, and keeps a parallel class-id-report census (which
# does read build/class) from ever picking up classes from a source version
# that has since moved on.
rm -rf build

if [ -z "$jar" ] && [ -f flix.jar ]; then
  jar=flix.jar
fi

if [ -z "$jar" ]; then
  jar=$(command -v flix) || true
fi

if [ -z "$jar" ] || [ ! -f "$jar" ]; then
  echo "error: no Flix compiler jar found (tried \$FLIX_JAR, ./flix.jar, and 'flix' on \$PATH)" >&2
  echo "place a jar at ./flix.jar, or pass --flix-jar" >&2
  exit 1
fi

# Labeling the report: an explicit --compiler-version always wins. Otherwise, this falls
# back to whatever the jar's own filename says (matching flixw's own cache-naming
# convention, e.g. flix-0.75.3-<sha256>.jar, in case FLIX_JAR happens to point at a copy of
# one) and finally to the resolved path itself, so the report always shows which jar
# actually produced it.
if [ -z "$compiler_version" ]; then
  base=$(basename "$jar")
  if [[ "$base" =~ ^flix-(.+)-[0-9a-f]{64}\.jar$ ]]; then
    compiler_version="${BASH_REMATCH[1]}"
  else
    compiler_version=$jar
  fi
fi

exec scala-cli run scripts/edit-resistance.scala --jvm 21 --jar "$jar" -- --compiler-version "$compiler_version" "${args[@]}"
