#!/usr/bin/env bash
# Runs edit-resistance.scala against a Flix compiler jar. `scala-cli`'s `using
# jar` directive is a static literal -- it cannot shell out or read an env
# var -- so edit-resistance.scala alone has no classpath and running it with
# `scala-cli run` directly fails to compile. This resolves the jar and hands
# it to scala-cli as `--jar`.
#
# This never goes through flixw, on purpose: the whole point of the lab is comparing two
# different compiler builds (counter-suffix vs. hash-suffix) against the same source, and
# flixw only ever holds one pinned jar at a time. Jar resolution, in order, first match wins:
#   1. --flix-jar <path>  passed on this script's own command line
#   2. $FLIX_JAR          same override convention flixw itself uses for
#                         running a compiler it did not download (see
#                         .envrc.example); unverified, same as there
#   3. ./flix.jar         a jar placed at the project root by hand
#   4. `flix` on $PATH    whatever a system-installed Flix resolves to.
#                         Only works if that is itself a jar (or a
#                         polyglot self-executing one, e.g. a shebang
#                         prepended to a real jar) -- scala-cli's --jar
#                         needs an actual jar, not a launcher script, and
#                         this is unverified either way
#
# Usage:
#   ./scripts/edit-resistance [source.flix]
#   ./scripts/edit-resistance --flix-jar path/to/flix.jar [source.flix]
#   ./scripts/edit-resistance --compiler-version string [source.flix]
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: ./scripts/edit-resistance [--flix-jar path/to/flix.jar] [source.flix]
                                  [--compiler-version string]

Measures how many generated class names, and how many generated classes,
survive a set of edits to source.flix (default: src/AllConstructs.flix).

Options:
  --flix-jar <path>        Flix compiler jar to compile against. Overrides
                            every other source below.
  --compiler-version <str> Label the report with what produced it. If not
                            given, this asks the resolved jar directly
                            (`java -jar ... --version`) and appends a short
                            digest of its own bytes, since two builds can
                            share a version string while differing in
                            every byte.
  -h, --help                Show this help and exit.

Jar resolution when --flix-jar is not given, first match wins. This never
consults flixw, even if present: it deliberately holds only one pinned jar,
and this needs to compare arbitrary builds against each other.
  1. $FLIX_JAR        unverified, as in .envrc.example
  2. ./flix.jar        a jar placed at the project root by hand
  3. `flix` on $PATH   a system-installed Flix, if it resolves to a jar
EOF
}

# Parsed here, ahead of everything else below, so --help/-h short-circuits
# before this wipes build/ or resolves a jar.
jar=${FLIX_JAR:-}
compiler_version=""
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --flix-jar)
      jar=$2
      shift 2
      ;;
    --flix-jar=*)
      jar=${1#--flix-jar=}
      shift
      ;;
    --compiler-version)
      compiler_version=$2
      shift 2
      ;;
    --compiler-version=*)
      compiler_version=${1#--compiler-version=}
      shift
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done

# Deliberately does not `cd` anywhere: a source.flix argument, or --flix-jar,
# is a path the caller gave relative to wherever they are, and resolving it
# against this script's own directory instead -- as `cd`-ing here first
# would -- silently measures (or looks for a jar at) the wrong thing when
# this is invoked via a relative path from outside the project. What must
# stay anchored to the project root regardless of caller cwd -- the default
# source, the project-root ./flix.jar fallback, this tool's own build/ -- is
# qualified with $root explicitly below instead.
root=$(cd "$(dirname "$0")/.." && pwd)

# This tool compiles in-process and never reads or writes build/ itself, but
# a stale build/ from an earlier ./flixw build or ./flixw test can linger
# alongside it. Wiping it here keeps a run's disk footprint to just what this
# invocation produces, and keeps a parallel class-id-report census (which
# does read build/class) from ever picking up classes from a source version
# that has since moved on.
rm -rf "$root/build"

if [ -z "$jar" ] && [ -f "$root/flix.jar" ]; then
  jar="$root/flix.jar"
fi

if [ -z "$jar" ]; then
  jar=$(command -v flix) || true
fi

if [ -z "$jar" ] || [ ! -f "$jar" ]; then
  echo "error: no Flix compiler jar found (tried \$FLIX_JAR, $root/flix.jar, and 'flix' on \$PATH)" >&2
  echo "place a jar at $root/flix.jar, or pass --flix-jar" >&2
  exit 1
fi

# No positional source.flix was given: fall back to this lab's own demo file
# explicitly, by absolute path, rather than leaving it to
# edit-resistance.scala's relative default -- which would otherwise resolve
# against the caller's cwd now that this never `cd`s.
if [ ${#args[@]} -eq 0 ]; then
  args+=("$root/src/AllConstructs.flix")
fi

# Labeling the report: an explicit --compiler-version always wins. Otherwise this asks the
# jar itself (`java -jar ... --version`) rather than parsing its cache filename -- that
# works no matter what the file is named or where it came from.
#
# The version alone is not enough to label with: two builds can print the identical version
# string while differing in every byte -- comparing exactly that is what this lab is for --
# so a self-computed digest (a short prefix, git-style) is always appended. It is computed
# from the jar's own bytes, not read out of a filename, so it holds even for a jar renamed
# away from flixw's flix-<version>-<sha256>.jar convention.
if [ -z "$compiler_version" ]; then
  version=$(java -jar "$jar" --version 2>/dev/null | awk '{print $NF}') || true
  digest=$( (shasum -a 256 "$jar" 2>/dev/null || sha256sum "$jar" 2>/dev/null) | awk '{print $1}') || true
  if [ -n "$version" ] && [ -n "$digest" ]; then
    compiler_version="$version (${digest:0:12})"
  elif [ -n "$version" ]; then
    compiler_version=$version
  else
    compiler_version=$jar
  fi
fi

exec scala-cli run "$root/scripts/edit-resistance.scala" --jvm 21 --jar "$jar" -- --compiler-version "$compiler_version" "${args[@]}"
