#!/usr/bin/env bash
# Runs fixtures-build.scala against a Flix compiler jar. `scala-cli`'s `using jar`
# directive is a static literal -- it cannot shell out or read an env var -- so
# fixtures-build.scala alone has no classpath and running it with `scala-cli run`
# directly fails to compile. This resolves the jar and hands it to scala-cli as
# `--jar`, the same way the other lab scripts do.
#
# This never goes through flixw, on purpose, same reason as the other lab scripts: flixw
# holds only one pinned jar at a time, and building the fixtures against an arbitrary
# build is the point. Jar resolution, in order, first match wins:
#   1. --flix-jar <path>  passed on this script's own command line
#   2. $FLIX_JAR          same override convention flixw itself uses for
#                         running a compiler it did not download (see
#                         .envrc.example); unverified, same as there
#   3. ./flix.jar         a jar placed at the project root by hand
#   4. `flix` on $PATH    whatever a system-installed Flix resolves to.
#                         Only works if that is itself a jar (or a
#                         polyglot self-executing one) -- scala-cli's
#                         --jar needs an actual jar, not a launcher script,
#                         and this is unverified either way
#
# Like scripts/fixtures-check, this one always `cd`s to the project root: it has no
# user-supplied path argument to accidentally resolve against the wrong directory -- it
# only ever builds this project's own fixtures/positive/ into build/fixtures/.
#
# Usage:
#   ./scripts/fixtures-build
#   ./scripts/fixtures-build --flix-jar path/to/flix.jar
#   ./scripts/fixtures-build --out build/fixtures
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: ./scripts/fixtures-build [--flix-jar path/to/flix.jar] [--compiler-version string] [--out dir]

Compiles every file under fixtures/positive/ for real and writes each one's generated
classes to its own subdirectory of build/fixtures/ (or --out), so scripts/class-id-report
can census a single fixture in isolation. fixtures/negative/ is skipped: it is built to
fail, by design, so there is nothing to write.

Options:
  --flix-jar <path>        Flix compiler jar to compile against. Overrides
                            every other source below.
  --compiler-version <str> Label the report with what produced it. If not
                            given, this asks the resolved jar directly
                            (`java -jar ... --version`) and appends a short
                            digest of its own bytes, since two builds can
                            share a version string while differing in
                            every byte.
  --out <dir>               Where to write classes. Default: build/fixtures,
                             wiped before every run.
  -h, --help                Show this help and exit.

Jar resolution when --flix-jar is not given, first match wins. This never
consults flixw, even if present: it deliberately holds only one pinned jar,
and this needs to point at whatever build is being checked.
  1. $FLIX_JAR        unverified, as in .envrc.example
  2. ./flix.jar        a jar placed at the project root by hand
  3. `flix` on $PATH   a system-installed Flix, if it resolves to a jar
EOF
}

# Parsed here, ahead of everything else below, so --help/-h short-circuits before
# resolving a jar.
jar=${FLIX_JAR:-}
compiler_version=""
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --flix-jar)
      jar=$2
      shift 2
      ;;
    --flix-jar=*)
      jar=${1#--flix-jar=}
      shift
      ;;
    --compiler-version)
      compiler_version=$2
      shift 2
      ;;
    --compiler-version=*)
      compiler_version=${1#--compiler-version=}
      shift
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done

root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"

if [ -z "$jar" ] && [ -f "$root/flix.jar" ]; then
  jar="$root/flix.jar"
fi

if [ -z "$jar" ]; then
  jar=$(command -v flix) || true
fi

if [ -z "$jar" ] || [ ! -f "$jar" ]; then
  echo "error: no Flix compiler jar found (tried \$FLIX_JAR, $root/flix.jar, and 'flix' on \$PATH)" >&2
  echo "place a jar at $root/flix.jar, or pass --flix-jar" >&2
  exit 1
fi

# Labeling the report: an explicit --compiler-version always wins. Otherwise this asks the
# jar itself (java -jar ... --version) rather than parsing its cache filename -- that works
# no matter what the file is named or where it came from. The version alone is not enough:
# two builds can print the identical version string while differing in every byte -- so a
# self-computed digest (a short prefix, git-style) is always appended too.
if [ -z "$compiler_version" ]; then
  version=$(java -jar "$jar" --version 2>/dev/null | awk '{print $NF}') || true
  digest=$( (shasum -a 256 "$jar" 2>/dev/null || sha256sum "$jar" 2>/dev/null) | awk '{print $1}') || true
  if [ -n "$version" ] && [ -n "$digest" ]; then
    compiler_version="$version (${digest:0:12})"
  elif [ -n "$version" ]; then
    compiler_version=$version
  else
    compiler_version=$jar
  fi
fi

exec scala-cli run "$root/scripts/fixtures-build.scala" --jvm 21 --jar "$jar" -- --compiler-version "$compiler_version" "${args[@]}"
