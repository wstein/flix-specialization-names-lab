#!/usr/bin/env bash
# Runs class-id-report.scala. This wrapper never needs the Flix compiler
# jar -- the script only reads an already-built build/class directory -- but
# it exists anyway so every script under scripts/ is invoked the same way:
# by its extensionless name, never by calling scala-cli on the .scala file
# directly.
#
# Usage:
#   ./scripts/class-id-report [class-directory-or-jar] [--output-dir directory] [--json]
# Deliberately does not `cd` anywhere: a class-directory-or-jar argument, or
# --output-dir, is a path the caller gave relative to wherever they are, and
# resolving it against this script's own directory instead -- as `cd`-ing
# here first would -- silently censuses (or writes) the wrong thing when
# this is invoked via a relative path from outside the project, e.g.
# `../scripts/class-id-report build/class` from a project one level down.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)

exec scala-cli run "$root/scripts/class-id-report.scala" -- "$@"
